<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xzit.mapper.StudentMapper">
    <select id="selectCondition" parameterType="Student" resultType="Student">
        select * from student
        <where>
          <if test="name!=null and name!=''">
              and name like #{name}
          </if>
          <if test="age!=null and age !=0">
              and age=#{age}
          </if>
          <if test="gender!=null and gender!=''">
              and gender=#{gender}
          </if>
         </where>
    </select>
    <select id="selectConditionChoose" parameterType="Student" resultType="Student">
        select * from student where 1=1
        <choose>
            <when test="name!=null and name!=''">
                and name like #{name}
            </when>
            <when test="age!=null and age!=0">
                and age=#{age}
            </when>
            <when test="gender!=null and gender!=''">
                and gender=#{gender}
            </when>
            <otherwise>
                order by age
            </otherwise>
        </choose>
    </select>
    <select id="count" parameterType="Student" resultType="long">
        select count(*) from student
        <where>
            <if test="name!=null and name!=''">
                and name like #{name}
            </if>
            <if test="age!=null and age !=0">
                and age=#{age}
            </if>
            <if test="gender!=null and gender!=''">
                and gender=#{gender}
            </if>
        </where>
    </select>
    <select id="selectConditionTrim" parameterType="Student" resultType="Student">
        select * from student
        <trim prefix="where" prefixOverrides="and">
            <if test="name!=null and name!=''">
                and name like #{name}
            </if>
            <if test="age!=null and age !=0">
                and age=#{age}
            </if>
            <if test="gender!=null and gender!=''">
                and gender=#{gender}
            </if>
        </trim>
    </select>
    <delete id="deleteCheck">
        delete from student
        <where>
            <foreach collection="array" item="id" open=" and id in(" close=")" separator=",">
                #{id}
            </foreach>
        </where>
    </delete>
    <delete id="deleteCheckList">
        delete from student
        <where>
            <foreach collection="list" item="id" open=" and id in(" close=")" separator=",">
                #{id}
            </foreach>
        </where>
    </delete>
    <delete id="delete" parameterType="Student">
        delete from student
        <where>
            <foreach collection="ids" item="id" open=" and id in(" close=")" separator=",">
                #{id}
            </foreach>
        </where>
    </delete>
    <insert id="insert">
        insert into student values
        <foreach collection="list" item="stu" separator=",">
            (default,#{stu.name},#{stu.age},#{stu.gender})
        </foreach>
    </insert>
    <select id="selectByName" parameterType="com.xzit.model.Stu" resultType="com.xzit.model.Stu">
        <bind name="condition" value="'%'+name+'%'"/>
        select * from student
        <where>
            <if test="name!=null and name !=''">
                and name like #{condition}
            </if>
        </where>
    </select>
</mapper>
